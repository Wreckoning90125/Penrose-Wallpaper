# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Local research docs
.local/
docs/superpowers/

# Log/OS Files
*.log

# Web toolchain/build output
node_modules/
dist/
.cache/
output/playwright/
.playwright-cli/

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files. The Android debug keystore at app/debug.keystore is
# intentionally committed: its password is the universal "android" and it
# only signs sideloadable builds, not Play Store releases.
*.jks
*.keystore
!android/app/debug.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Python bytecode cache from tools/ scripts
__pycache__/
*.pyc

# Local agent loop state
.claude/ralph-loop.local.md

# ── Belt-and-suspenders: things not present today but that this stack
#    (Vite + TS + React, Android Gradle + C++, Python tools, Playwright, WSL)
#    will eventually try to drop here. Add precisely; don't whitelist later. ──

# OS & editor
.DS_Store
Thumbs.db
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Windows / WSL (these breed constantly under WSL)
*:Zone.Identifier

# Environment & secrets
*.env
.env*
*.local

# TypeScript / Vite build state
.tsbuildinfo
*.tsbuildinfo*
dist-ssr/
vite.config.ts.timestamp-*

# Caches
.eslintcache
.pytest_cache/
.ruff_cache/

# npm/yarn debug logs (already covered by *.log, but explicit)
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
test-results/

# Gate markers (ephemeral, written by npm gate scripts)
.gate-results/

# Archive, backups & scratch
/archive/
/backups/
/tmp/
repomix/
*.tgz
a.out

# AI agent orchestration (local-only state)
.mcp.json
.claude/worktrees/
.claude/*.lock
/.claude/plans/
.codex/worktrees/
