<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />
    <!-- Vulkan 1.3.0 encoded as (1 << 22) | (3 << 12) = 0x00403000. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00403000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="1"
        android:required="false" />

    <!-- Media playback. POST_NOTIFICATIONS is the runtime permission the
         media-style notification needs on API 33+; without it the
         system-rendered media UI is invisible in the shade. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.penrose.wallpaper.PenroseApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasCode="true"
        android:theme="@style/Theme.Penrose">

        <service
            android:name="com.penrose.wallpaper.PenroseWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter android:priority="1">
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Media3 MediaSessionService for audio playback. Surfaces in
             the system media controls; required exported=true so
             external controllers (system UI, Assistant, Wear) can bind.

             Lint flags this as ExportedService-without-permission, but
             a MediaSessionService is itself the authorisation surface
             — Media3's session controller protocol gates which calls
             external apps can issue (READY/PLAYING transitions,
             skipNext, etc.). Adding a custom Android permission here
             would block the system media UI and Assistant from
             binding, which is precisely the integration the service
             exists for. The `tools:ignore` makes the trade-off
             explicit in CI rather than hiding it in a baseline file. -->
        <service
            android:name="com.penrose.wallpaper.audio.AudioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <activity
            android:name="com.penrose.wallpaper.LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.penrose.wallpaper.SettingsActivity"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:theme="@style/Theme.Penrose" />

        <!-- Full-bleed live preview, no settings sheet. Tap the screen to
             return to SettingsActivity. -->
        <activity
            android:name="com.penrose.wallpaper.FullScreenActivity"
            android:exported="false"
            android:theme="@style/Theme.Penrose" />
    </application>
</manifest>

