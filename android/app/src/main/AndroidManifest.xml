<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />
    <!-- Vulkan 1.3.0 encoded as (1 << 22) | (3 << 12) = 0x00403000. We
         negotiate apiVersion 1.3 at runtime and only enable 1.3-promoted
         features (dynamicRendering, sync2). Listing 1.4 here would hide the
         wallpaper from system pickers on every shipping device that doesn't
         report 1.4 support — i.e. essentially all of them in 2026. Bump to
         0x00404000 alongside the renderer.cpp apiVersion when both the NDK
         ships proper 1.4 headers and a meaningful share of devices report it. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00403000"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="1"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:hasCode="true"
        android:theme="@style/Theme.Penrose">

        <service
            android:name="com.penrose.wallpaper.PenroseWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter android:priority="1">
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Launcher shim. Tapping the app drawer icon fires
             ACTION_CHANGE_LIVE_WALLPAPER pointed at our own service, which
             jumps straight to the system live-wallpaper preview. Samsung
             OneUI's "Wallpaper services" picker is reserved for Samsung-
             signed services, so without this shim the wallpaper is
             unreachable on Galaxy devices. Theme.NoDisplay so the shim never
             paints a blank window. -->
        <activity
            android:name="com.penrose.wallpaper.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.penrose.wallpaper.SettingsActivity"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:theme="@style/Theme.Penrose" />
    </application>
</manifest>
