<?xml version="1.0" encoding="utf-8"?>
<!--
Adaptive launcher icon (API 26+). The OS composes <background> and
<foreground> per its own mask shape. mipmap-anydpi-v26 means this
single XML serves every density; older mipmap-*dpi assets
aren't shipped because minSdk = 36.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
