<?xml version="1.0" encoding="utf-8"?>
<!--
Android 12+ replacement for the deprecated android:allowBackup +
android:fullBackupContent pair. We opt OUT of both cloud-backup and
device-transfer for everything in the app's data dir, for two
reasons:

  1. Live wallpaper renderer state is private app state, not a portable
     account profile.
  2. The crash handler writes filesDir/crash.log on native faults.
     Cloud-backing up crash dumps from one device to another would be
     actively misleading.

-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
