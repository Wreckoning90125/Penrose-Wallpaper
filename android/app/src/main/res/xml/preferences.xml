<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Actions">
        <Preference
            android:key="action_apply_wallpaper"
            android:title="@string/apply_wallpaper_title"
            android:summary="@string/apply_wallpaper_summary" />
        <Preference
            android:key="action_full_screen"
            android:title="Full screen"
            android:summary="Open the live wallpaper full-bleed in the app. Tap to dismiss." />
        <Preference
            android:key="action_node_editor"
            android:title="Node editor"
            android:summary="Open the full-screen modulation graph (ImGui). Add / connect / delete any source, operator, or target." />
        <Preference
            android:key="action_load_preset"
            android:title="@string/preset_load_title"
            android:summary="@string/preset_load_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Adjust">
        <Preference
            android:key="nav_tiling"
            android:title="Tiling"
            android:summary="Family, seed, generation, pan mode" />
        <Preference
            android:key="nav_color"
            android:title="Color"
            android:summary="Palette, brightness, depth, custom slots" />
        <Preference
            android:key="nav_borders"
            android:title="Borders"
            android:summary="Width, OKLCH color, alpha" />
        <Preference
            android:key="nav_motion"
            android:title="Motion"
            android:summary="Ripple amplitude, speed, kind, mode" />
        <Preference
            android:key="nav_background"
            android:title="Background"
            android:summary="Mode + OKLCH color" />
        <Preference
            android:key="nav_audio"
            android:title="@string/audio_category"
            android:summary="@string/audio_file_summary" />
    </PreferenceCategory>
</PreferenceScreen>
