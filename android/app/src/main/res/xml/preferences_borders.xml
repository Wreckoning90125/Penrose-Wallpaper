<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="nav_back"
        android:title="← Back"
        android:summary="" />

    <PreferenceCategory android:title="Borders">
        <SwitchPreferenceCompat
            android:key="border_on"
            android:title="Show borders"
            android:defaultValue="true" />
        <SeekBarPreference
            android:key="border_width"
            android:title="Width"
            android:summary="Tile-local inset width"
            android:min="0" android:max="600" android:defaultValue="80"
            app:showSeekBarValue="true" />
        <ListPreference
            android:key="border_join"
            android:title="Join"
            android:summary="%s"
            android:entries="@array/border_join_entries"
            android:entryValues="@array/border_join_values"
            android:defaultValue="0" />
        <SeekBarPreference
            android:key="border_fill"
            android:title="Fill"
            android:summary="Pull convex corner insets toward the tile center"
            android:min="0" android:max="100" android:defaultValue="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="border_point"
            android:title="Point"
            android:summary="Trim sharp convex border tips"
            android:min="0" android:max="100" android:defaultValue="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="border_gap"
            android:title="Close gap"
            android:summary="Taper inner border edges into shared vertices"
            android:min="0" android:max="100" android:defaultValue="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="border_a"
            android:title="Alpha"
            android:min="0" android:max="100" android:defaultValue="35"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="border_l"
            android:title="Lightness (OKLCH L ×100)"
            android:min="0" android:max="100" android:defaultValue="95"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="border_c"
            android:title="Chroma (OKLCH C ×100)"
            android:min="0" android:max="37" android:defaultValue="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="border_h"
            android:title="Hue (degrees)"
            android:min="0" android:max="359" android:defaultValue="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="edge_profile_width"
            android:title="Inner edge profile"
            android:summary="Surface inlay width from true tile edge distance"
            android:min="0" android:max="100" android:defaultValue="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="edge_profile_glow"
            android:title="Inner edge glow"
            android:min="0" android:max="100" android:defaultValue="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="edge_profile_l"
            android:title="Inner edge lightness (OKLCH L ×100)"
            android:min="0" android:max="100" android:defaultValue="100"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="edge_profile_c"
            android:title="Inner edge chroma (OKLCH C ×100)"
            android:min="0" android:max="37" android:defaultValue="0"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="edge_profile_h"
            android:title="Inner edge hue (degrees)"
            android:min="0" android:max="359" android:defaultValue="0"
            app:showSeekBarValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
