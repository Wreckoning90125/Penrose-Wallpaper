{
  "name": "penrose-wallpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "atlas:verify": "python3 tools/verify_atlas.py",
    "cpp:build": "bash tools/check_native_build.sh",
    "cpp:build:tidy": "PENROSE_TIDY=1 bash tools/check_native_build.sh",
    "cpp:tidy": "bash tools/run_clang_tidy.sh",
    "js:policy": "python3 tools/check_plain_js.py",
    "quality:web": "npm run js:policy && npm run ts:policy && npm run typecheck && npm run atlas:verify && npm run render-geometry:verify && npm run order-five-ifs:verify && npm run truchet:verify && npm run border:verify && npm run web:build && npm run graph:contract",
    "quality:native": "npm run tilings:verify && npm run cpp:tidy && npm run cpp:build:tidy",
    "quality:android": "npm run shaders:validate",
    "quality:local": "npm run quality:web && npm run quality:native && npm run quality:android",
    "shaders:validate": "bash tools/validate_shaders.sh",
    "border:verify": "node tools/verify_border_joins.mts",
    "render-geometry:verify": "node --import ./tools/register_extensionless_loader.mts tools/verify_render_geometry.mts",
    "graph:contract": "node --import ./tools/register_extensionless_loader.mts tools/check_graph_contract.mts",
    "order-five-ifs:verify": "node --import ./tools/register_extensionless_loader.mts tools/verify_order_five_ifs.mts",
    "truchet:verify": "node --import ./tools/register_extensionless_loader.mts tools/verify_truchet_sources.mts",
    "tilings:verify": "g++ -std=c++20 -O2 -Wall -Wextra -I android/app/src/main/cpp tools/verify_tilings.cpp android/app/src/main/cpp/tiling/penrose.cpp -o .cache/verify_tilings && .cache/verify_tilings",
    "ts:policy": "node tools/check_typescript_policy.mts",
    "typecheck": "tsc --noEmit",
    "web:generate": "python3 tools/generate_web_geometry.py",
    "preweb:dev": "npm run web:generate",
    "preweb:dev:alt": "npm run web:generate",
    "dev": "npm run web:dev",
    "web:dev": "node scripts/dev/run-owned-vite.mts serve",
    "web:dev:alt": "node scripts/dev/run-owned-vite.mts serve --port 5274",
    "preweb:build": "npm run web:generate",
    "web:build": "vite build",
    "web:preview": "node scripts/dev/run-owned-vite.mts preview",
    "web:preview:alt": "node scripts/dev/run-owned-vite.mts preview --port 4274",
    "web:shot": "node scripts/dev/headed-browser.mts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "8.2.2"
  }
}
