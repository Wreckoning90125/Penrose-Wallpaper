<?xml version="1.0"?>
<materialx version="1.39">
  <surfacematerial name="mat_penrose_surface" type="material" nodedef="ND_surfacematerial">
    <input name="surfaceshader" type="surfaceshader" nodename="penrose_standard_surface" />
  </surfacematerial>
  <standard_surface name="penrose_standard_surface" type="surfaceshader" nodedef="ND_standard_surface_surfaceshader">
    <input name="base_color" type="color3" value="1.0, 1.0, 1.0" />
    <input name="opacity" type="float" value="1.0" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_color" type="color3" value="1.0, 1.0, 1.0" />
    <input name="ior" type="float" value="1.5" />
    <input name="specular_roughness" type="float" value="0.38" />
    <input name="metalness" type="float" value="0.0" />
    <input name="thin_film_thickness" type="float" value="120.0" />
    <input name="thin_film_ior" type="float" value="1.5" />
    <input name="sheen" type="float" value="0.12" />
    <input name="sheen_roughness" type="float" value="0.5" />
    <input name="coat" type="float" value="0.62" />
    <input name="coat_roughness" type="float" value="0.38" />
  </standard_surface>
</materialx>
